#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

#define MAX_FLIGHTS 100
#define MAX_PASSENGERS 500
#define CODE_LEN 20

typedef struct {
    char code[CODE_LEN];
    char from[50];
    char to[50];
    char date[15]; 
    char time[10]; 
    double price;
    int capacity;
    int booked;
    int active;    
} Flight;

typedef struct {
    char ticket[20];
    char flightCode[CODE_LEN];
    char fullName[50];
    char phone[15];
    int active;    
} Passenger;

Flight flights[MAX_FLIGHTS];
int flightCount = 0;

Passenger passengers[MAX_PASSENGERS];
int passengerCount = 0;

// Khai báo nguyên mẫu hàm
void menu(void);
int validPhone(const char *phone);
int phoneExists(const char *phone);
int validDate(const char *date);
int validTime(const char *time);
int findFlight(const char *code);
int findPassenger(const char *ticket);
void readLine(const char *prompt, char *str, int size);
double readDouble(const char *prompt, double min);
int readInt(const char *prompt, int min, int max);

void printFlight(const Flight *f);
void addFlight(void);
void listFlights(void);
void searchFlights(void);
void sortFlights(void);
void bookTicket(void);
void cancelTicket(void);
void listTickets(void);
void searchTicket(void);
void updateFlight(void);
void deleteFlight(void);
void revenueReport(void);
void saveData(void);
void loadData(void);

// ================= IMPLEMENTATION =================

void menu(void)
{
    puts("\n========== QUAN LY CHUYEN BAY & DAT VE ==========");
    puts("1. Them chuyen bay");
    puts("2. Xem danh sach chuyen bay");
    puts("3. Tim/loc chuyen bay");
    puts("4. Sap xep chuyen bay");
    puts("5. Dat ve");
    puts("6. Huy ve");
    puts("7. Xem danh sach ve");
    puts("8. Tim ve theo ma");
    puts("9. Cap nhat chuyen bay");
    puts("10. Xoa chuyen bay");
    puts("11. Thong ke doanh thu");
    puts("0. Luu va thoat");
}

int validPhone(const char *phone)
{
    int len = strlen(phone);
    if(len < 10 || len > 11)
        return 0;
    for(int i = 0; i < len; i++)
    {
        if(!isdigit((unsigned char)phone[i]))
            return 0;
    }
    return 1;
}

int phoneExists(const char *phone)
{
    for(int i = 0; i < passengerCount; i++)
    {
        if(passengers[i].active && strcmp(passengers[i].phone, phone) == 0)
        {
            return 1;
        }
    }
    return 0;
}

int validDate(const char *date) { return strlen(date) == 10; }

int validTime(const char *time) { 
    int h, m;
    if (sscanf(time, "%d:%d", &h, &m) != 2) return 0;
    if (h < 0 || h > 23 || m < 0 || m > 59) return 0;
    return 1;
}

int findFlight(const char *code) {
    for(int i = 0; i < flightCount; i++) {
        if(flights[i].active && strcmp(flights[i].code, code) == 0) return i;
    }
    return -1;
}

int findPassenger(const char *ticket) {
    for(int i = 0; i < passengerCount; i++) {
        if(passengers[i].active && strcmp(passengers[i].ticket, ticket) == 0) return i;
    }
    return -1;
}

void readLine(const char *prompt, char *str, int size) {
    printf("%s", prompt);
    if(fgets(str, size, stdin)) {
        str[strcspn(str, "\n")] = 0;
    }
}

double readDouble(const char *prompt, double min) {
    double val;
    char buffer[100];
    while(1) {
        readLine(prompt, buffer, sizeof(buffer));
        val = atof(buffer);
        if(val >= min) return val;
        printf("Gia tri khong hop le. Phai >= %.0f\n", min);
    }
}

int readInt(const char *prompt, int min, int max) {
    int val;
    char buffer[100];
    while(1) {
        readLine(prompt, buffer, sizeof(buffer));
        val = atoi(buffer);
        if(val >= min && val <= max) return val;
        printf("Gia tri khong hop le. Phai tu %d den %d\n", min, max);
    }
}

void printFlight(const Flight *f) {
    printf("Ma: %s | Tu: %s -> Den: %s | Ngay: %s %s | Gia: %.0f | Ghe: %d/%d\n",
           f->code, f->from, f->to, f->date, f->time, f->price, f->booked, f->capacity);
}

void addFlight(void) { 
    if(flightCount >= MAX_FLIGHTS) {
        puts("Danh sach chuyen bay da day.");
        return;
    }
    Flight f;
    readLine("Ma chuyen bay: ", f.code, sizeof(f.code));
    readLine("Noi di: ", f.from, sizeof(f.from));
    readLine("Noi den: ", f.to, sizeof(f.to));
    
    do {
        readLine("Ngay bay (YYYY-MM-DD): ", f.date, sizeof(f.date));
        if(!validDate(f.date)) puts("Ngay khong hop le.");
    } while(!validDate(f.date));

    do {
        readLine("Gio bay (HH:MM): ", f.time, sizeof(f.time));
        if(!validTime(f.time)) puts("Gio khong hop le.");
    } while(!validTime(f.time));

    f.price = readDouble("Gia ve: ", 1000);
    f.capacity = readInt("So ghe: ", 1, 500);
    f.booked = 0;
    f.active = 1;

    flights[flightCount++] = f;
    saveData();
    puts("Them chuyen bay thanh cong.");
}

void listFlights(void) { 
    puts("\n--- DANH SACH CHUYEN BAY ---");
    int count = 0;
    for(int i = 0; i < flightCount; i++) {
        if(flights[i].active) {
            printFlight(&flights[i]);
            count++;
        }
    }
    if(count == 0) puts("Chua co chuyen bay nao.");
}

// === CHUC NANG 3: TIM/LOC CHUYEN BAY ===
void searchFlights(void) {
    char keyword[50];
    readLine("Nhap noi di hoac noi den can tim: ", keyword, sizeof(keyword));
    
    puts("\n--- KET QUA TIM KIEM ---");
    int count = 0;
    for(int i = 0; i < flightCount; i++) {
        if(flights[i].active && (strcasecmp(flights[i].from, keyword) == 0 || strcasecmp(flights[i].to, keyword) == 0)) {
            printFlight(&flights[i]);
            count++;
        }
    }
    if(count == 0) {
        puts("Khong tim thay chuyen bay phu hop.");
    }
}

// === CHUC NANG 6: HUY VE ===
void cancelTicket(void) {
    char ticket[20];
    readLine("Nhap ma ve can huy: ", ticket, sizeof(ticket));
    
    int pIdx = findPassenger(ticket);
    if(pIdx < 0) {
        puts("Khong tim thay ma ve nay.");
        return;
    }
    
    Passenger *p = &passengers[pIdx];
    int fIdx = findFlight(p->flightCode);
    
    // Danh dau ve khong hoat dong
    p->active = 0;
    
    // Giam so luong ghe da dat cua chuyen bay tuong ung
    if(fIdx >= 0 && flights[fIdx].booked > 0) {
        flights[fIdx].booked--;
    }
    
    saveData();
    puts("Huy ve thanh cong.");
}

void listTickets(void) {
    puts("\n--- DANH SACH VE DA DAT ---");
    int count = 0;
    for(int i = 0; i < passengerCount; i++) {
        if(passengers[i].active) {
            printf("Ma ve: %s | Chuyen bay: %s | Ho ten: %s | SDT: %s\n",
                   passengers[i].ticket,
                   passengers[i].flightCode,
                   passengers[i].fullName,
                   passengers[i].phone);
            count++;
        }
    }
    if(count == 0) {
        puts("Chua co ve nao duoc dat.");
    }
}

void saveData(void) { /* Luu file */ }

void searchTicket(void)
{
    char ticket[20];
    readLine("Nhap ma ve: ", ticket, sizeof(ticket));
    int idx = findPassenger(ticket);

    if(idx < 0)
    {
        puts("Khong tim thay ve.");
        return;
    }

    Passenger *p = &passengers[idx];
    printf("\n==============================\n");
    printf("Ma ve      : %s\n", p->ticket);
    printf("Chuyen bay  : %s\n", p->flightCode);
    printf("Ho ten      : %s\n", p->fullName);
    printf("Dien thoai  : %s\n", p->phone);
    printf("==============================\n");
}

void updateFlight(void)
{
    char code[CODE_LEN];
    readLine("Nhap ma chuyen bay can sua: ", code, sizeof(code));
    int idx = findFlight(code);

    if(idx < 0)
    {
        puts("Khong tim thay.");
        return;
    }

    Flight *f = &flights[idx];
    printf("\nThong tin hien tai:\n");
    printFlight(f);

    readLine("Noi di moi: ", f->from, sizeof(f->from));
    readLine("Noi den moi: ", f->to, sizeof(f->to));

    do
    {
        readLine("Ngay bay moi (YYYY-MM-DD): ", f->date, sizeof(f->date));
        if(!validDate(f->date))
            puts("Ngay khong hop le.");
    }
    while(!validDate(f->date));

    do
    {
        readLine("Gio bay moi (HH:MM): ", f->time, sizeof(f->time));
        if(!validTime(f->time))
            puts("Gio khong hop le.");
    }
    while(!validTime(f->time));

    f->price = readDouble("Gia ve moi: ", 1000);
    f->capacity = readInt("So ghe moi: ", f->booked, 500);

    saveData();
    puts("Cap nhat thanh cong.");
}

void deleteFlight(void)
{
    char code[CODE_LEN];
    readLine("Nhap ma chuyen bay: ", code, sizeof(code));
    int idx = findFlight(code);

    if(idx < 0)
    {
        puts("Khong tim thay.");
        return;
    }

    flights[idx].active = 0;
    saveData();
    puts("Da xoa chuyen bay.");
}

void revenueReport(void)
{
    double revenue = 0;
    for(int i = 0; i < passengerCount; i++)
    {
        if(!passengers[i].active)
            continue;

        int idx = findFlight(passengers[i].flightCode);
        if(idx >= 0)
            revenue += flights[idx].price;
    }

    printf("\nTong doanh thu: %.0f VND\n", revenue);
}

void bookTicket(void)
{
    if(passengerCount >= MAX_PASSENGERS)
    {
        puts("Danh sach hanh khach da day.");
        return;
    }

    char code[CODE_LEN];
    Passenger p = {0};

    readLine("Nhap ma chuyen bay: ", code, sizeof(code));
    int idx = findFlight(code);

    if(idx < 0)
    {
        puts("Khong ton tai chuyen bay.");
        return;
    }

    if(flights[idx].booked >= flights[idx].capacity)
    {
        puts("Da het cho.");
        return;
    }

    readLine("Ho ten: ", p.fullName, sizeof(p.fullName));
    if(strlen(p.fullName) < 3)
    {
        puts("Ten khong hop le.");
        return;
    }

    readLine("So dien thoai: ", p.phone, sizeof(p.phone));
    if(!validPhone(p.phone))
    {
        puts("So dien thoai khong hop le.");
        return;
    }

    snprintf(p.ticket, sizeof(p.ticket), "VE%06d", passengerCount + 1);
    strcpy(p.flightCode, code);
    p.active = 1;

    passengers[passengerCount++] = p;
    flights[idx].booked++;
    saveData();

    printf("\nDat ve thanh cong\n");
    printf("Ma ve: %s\n", p.ticket);
    printf("Gia tien: %.0f VND\n", flights[idx].price);
}

int compareFlight(const void *a, const void *b)
{
    const Flight *f1 = (const Flight*)a;
    const Flight *f2 = (const Flight*)b;

    int cmp = strcmp(f1->date, f2->date);
    if(cmp != 0)
        return cmp;

    return strcmp(f1->time, f2->time);
}

void sortFlights(void)
{
    qsort(flights, flightCount, sizeof(Flight), compareFlight);
    puts("Da sap xep.");
    listFlights();
}

int main(void) {
    int choice;
    do {
        menu();
        choice = readInt("Lua chon cua ban: ", 0, 11);
        
        switch(choice)
        {
            case 1: addFlight(); break;
            case 2: listFlights(); break;
            case 3: searchFlights(); break;
            case 4: sortFlights(); break;
            case 5: bookTicket(); break;
            case 6: cancelTicket(); break;
            case 7: listTickets(); break;
            case 8: searchTicket(); break;
            case 9: updateFlight(); break;
            case 10: deleteFlight(); break;
            case 11: revenueReport(); break;
            case 0:
                saveData();
                puts("Da luu du lieu. Tam biet!");
                return 0;
        }
    } while(1);

    return 0;
}
